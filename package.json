{
  "name": "miau-surveillance-free",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "description": "🐱 Miau Surveillance Free — Surveillance Toolkit built by cats, made in Germany",
  "scripts": {
    "dev": "vite --port 5199 --host",
    "build": "test -f src/api/windy-keys.ts || cp src/api/windy-keys.example.ts src/api/windy-keys.ts; tsc && vite build",
    "preview": "node server.cjs",
    "start": "node server.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "present": "cd public && python3 -m http.server 5200"
  },
  "dependencies": {
    "hls.js": "^1.6.17",
    "leaflet": "^1.9.4",
    "leaflet-velocity": "^2.1.4",
    "leaflet.markercluster": "^1.5.3",
    "satellite.js": "^7.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.8",
    "@types/leaflet.markercluster": "^1.5.4",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^30.0.1",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
